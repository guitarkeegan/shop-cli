.PHONY: build test lint demos clean

## build: compile the shop binary to ./tmp/shop
build:
	go build -o tmp/shop ./cmd

## test: run all tests
test:
	go test ./...

## lint: run go vet and staticcheck
lint:
	go vet ./...
	go run honnef.co/go/tools/cmd/staticcheck@latest ./...

## demos: re-record the README GIFs with vhs (https://github.com/charmbracelet/vhs)
demos: build
	mkdir -p sections blocks snippets
	PATH="$(CURDIR)/tmp:$$PATH" vhs section-cli.tape
	PATH="$(CURDIR)/tmp:$$PATH" vhs snippet-cli.tape
	PATH="$(CURDIR)/tmp:$$PATH" vhs section-fulltui.tape
	$(MAKE) clean

## clean: remove build output and files generated by the demos
clean:
	rm -rf tmp sections blocks snippets src

{%- liquid
  assign label = label
  assign id = id
  assign name = name
  assign value = value
  assign checked = checked | default: false
-%}

<div class="filters__field filters__field--checkbox">
  <input
    type="checkbox"
    class="sr-only"
    id="{{ id }}"
    name="{{ name }}"
    value="{{ value }}"
    {%- if checked -%}
      checked="checked"
    {%- endif -%}
  >
  <label for="{{ id }}" class="filters__input-display"> </label>
  <label for="{{ id }}">
    {{ label }}
  </label>
</div>

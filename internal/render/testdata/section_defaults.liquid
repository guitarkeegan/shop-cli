{% liquid
assign title = section.settings.title
assign color_scheme = section.settings.color_scheme
assign padding_top = section.settings.padding_top
assign padding_bottom = section.settings.padding_bottom
%}
{% schema %}
{
  "name": "Feature",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "id": "title",
      "type": "text",
      "label": "Title"
    },
    {
      "type": "header",
      "content": "t:sections.general.theme.header"
    },
    {
      "id": "color_scheme",
      "type": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "Primary"
    },
    {
      "id": "padding_top",
      "type": "range",
      "label": "Top padding",
      "default": 36,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "id": "padding_bottom",
      "type": "range",
      "label": "Bottom padding",
      "default": 36,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Feature"
    }
  ]
}
{% endschema %}
